# 필수 — BFF와 같은 PostgreSQL. PGlite(임베디드)는 프로세스 밖에서 접속할 수 없으므로
# push-server는 실제 Postgres가 필요하다 (`bun run infra:up`).
DATABASE_URL=postgres://tooday:tooday@localhost:5432/tooday

# 폴링 주기(초). 알림 정밀도는 이 주기만큼 늦을 수 있다.
# PUSH_POLL_INTERVAL_SECS=30

# due 창의 과거 한도(분) — 서버가 이만큼 죽어 있어도 밀린 알림을 복구한다.
# PUSH_LOOKBACK_MIN=10

# tasks.date/start_at(시간대 없는 로컬 값)을 해석할 IANA 시간대.
# PUSH_TIMEZONE=Asia/Seoul

# 발송기: log(기본 — 로그로만, 실발송 없음) | expo(Expo Push API)
# PUSH_SENDER=log

# 구독 등록/해제 HTTP API — BFF의 BFF_JWT_SECRET와 같은 값을 넣으면 켜진다.
# 미설정이면 API 없이 스케줄러만 돈다.
# PUSH_JWT_SECRET=change-me-in-production
# PUSH_HTTP_ADDR=127.0.0.1:3003

# 로그 레벨 (tracing EnvFilter)
# RUST_LOG=tooday_push_server=info
