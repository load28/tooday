# API_PORT=3003
# API_PG_POOL_SIZE=10
# RUST_LOG=tooday_api=info

# PostgreSQL — 필수 저장소. 미설정 시 docker-compose 기본값으로 붙는다:
#   bun run infra:up 으로 띄운 뒤 그대로 개발하면 된다.
# DATABASE_URL=postgres://tooday:tooday@localhost:5432/tooday

# Redis 리프레시 토큰 저장소 — 미설정이면 DB 테이블 사용.
# REDIS_URL=redis://localhost:6379

# 인증 — 액세스(JWT, 무상태) + 리프레시(회전) 토큰. 내부 동작은 전부 이 서비스가 소유한다.
# API_JWT_SECRET는 프로덕션 필수(미설정 시 부팅 거부). 개발은 안전하지 않은 기본값으로 동작.
# API_JWT_SECRET=change-me-in-production
# API_ACCESS_TTL_MS=900000            # 액세스 15분
# API_REFRESH_IDLE_TTL_MS=1209600000  # 리프레시 idle(슬라이딩) 14일
# API_REFRESH_ABSOLUTE_TTL_MS=7776000000  # 리프레시 absolute(하드캡) 90일

# BFF ↔ API 내부 인증 토큰 — 프로덕션 필수. BFF의 API_INTERNAL_TOKEN과 같은 값이어야 한다.
# INTERNAL_API_TOKEN=change-me-in-production
