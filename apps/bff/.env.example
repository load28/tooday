BFF_PORT=3002
BFF_ALLOWED_ORIGINS=http://localhost:3000
BFF_LOG_FORMAT=pretty

# 인증 — 액세스(JWT, 무상태) + 리프레시(회전) 토큰.
# BFF_JWT_SECRET는 프로덕션 필수(미설정 시 부팅 거부). 개발은 안전하지 않은 기본값으로 동작.
# BFF_JWT_SECRET=change-me-in-production
# BFF_ACCESS_COOKIE=tooday_access
# BFF_REFRESH_COOKIE=tooday_refresh
# BFF_ACCESS_TTL_MS=900000            # 액세스 15분
# BFF_REFRESH_IDLE_TTL_MS=1209600000  # 리프레시 idle(슬라이딩) 14일
# BFF_REFRESH_ABSOLUTE_TTL_MS=7776000000  # 리프레시 absolute(하드캡) 90일

# 저장소 — 기본은 외부 의존성 0(임베디드 PGlite + DB 리프레시 토큰 테이블).
# 실제 서버로 붙이려면 `bun run infra:up`(docker compose)으로 띄운 뒤 아래 주석을 해제한다.

# PostgreSQL — 미설정이면 임베디드 PGlite(BFF_PGLITE_DIR)로 동작.
# DATABASE_URL=postgres://tooday:tooday@localhost:5432/tooday
# BFF_PGLITE_DIR=.data/pglite
# BFF_PG_POOL_SIZE=10

# Redis 리프레시 토큰 저장소 — 미설정이면 DB 테이블 사용.
# REDIS_URL=redis://localhost:6379

# Redis 통합 테스트 전용 접속(우선) — 미설정 시 REDIS_URL로 폴백. 둘 다 없으면 통합 테스트는 스킵.
# 테스트는 전용 논리 DB(index 15)를 FLUSHDB하므로 실 데이터와 격리된 인스턴스를 권장한다.
# REDIS_TEST_URL=redis://localhost:6379
