BFF_PORT=3002
BFF_ALLOWED_ORIGINS=http://localhost:3000
BFF_LOG_FORMAT=pretty

# 러스트 API(apps/api) — 인증·데이터의 실제 내부 동작은 전부 여기로 위임된다.
# API_URL=http://localhost:3003
# INTERNAL_API_TOKEN는 프로덕션 필수(미설정 시 부팅 거부) — API의 같은 이름 env와 동일 값.
# INTERNAL_API_TOKEN=change-me-in-production

# 쿠키 — 이름과 수명(maxAge)은 표현 관심사라 BFF가 소유한다.
# 수명은 API의 토큰 TTL(API_ACCESS_TTL_MS / API_REFRESH_ABSOLUTE_TTL_MS)과 맞춘다.
# BFF_ACCESS_COOKIE=tooday_access
# BFF_REFRESH_COOKIE=tooday_refresh
# BFF_ACCESS_TTL_MS=900000            # 액세스 쿠키 15분
# BFF_REFRESH_ABSOLUTE_TTL_MS=7776000000  # 리프레시 쿠키 90일 (absolute 하드캡)
