{
  "name": "tooday",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.13",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "biome lint",
    "lint:deps": "depcruise --config .dependency-cruiser.cjs apps packages",
    "check": "biome check",
    "format": "biome format",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.5",
    "dependency-cruiser": "^17.3.10",
    "lefthook": "^2.1.6",
    "turbo": "^2.9.7",
    "typescript": "^6.0.2"
  },
  "engines": {
    "node": ">=24.0.0",
    "bun": ">=1.3.0"
  }
}
